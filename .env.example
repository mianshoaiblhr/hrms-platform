# ============================================================
# HRMS PLATFORM - ENVIRONMENT CONFIGURATION
# Copy this file to .env and update values
# ============================================================

APP_NAME="HRMS Platform"
APP_ENV=production
APP_URL=https://yourdomain.com
APP_KEY=base64:GENERATE_RANDOM_32_CHAR_KEY_HERE
APP_DEBUG=false
APP_TIMEZONE=Asia/Karachi
APP_LOCALE=en

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=hrms_db
DB_USERNAME=hrms_user
DB_PASSWORD=STRONG_DB_PASSWORD_HERE
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Security
SESSION_LIFETIME=120
SESSION_SECURE=true
CSRF_TOKEN_LIFETIME=3600
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900
PASSWORD_EXPIRE_DAYS=90
BCRYPT_ROUNDS=12

# Mail / SMTP
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@company.com
MAIL_PASSWORD=SMTP_PASSWORD_HERE
MAIL_ENCRYPTION=tls
MAIL_FROM_NAME="HRMS System"
MAIL_FROM_ADDRESS=noreply@company.com

# File Storage
STORAGE_PATH=/var/www/hrms_storage
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,jpg,jpeg,png

# Logging
LOG_LEVEL=warning
LOG_PATH=/var/log/hrms
LOG_MAX_FILES=30

# Encryption
ENCRYPT_KEY=RANDOM_32_CHAR_ENCRYPTION_KEY_HERE

# SMS (Optional)
SMS_DRIVER=twilio
SMS_FROM=+923000000000
TWILIO_SID=
TWILIO_TOKEN=

# 2FA
TWO_FACTOR_ENABLED=false
GOOGLE_AUTH_ISSUER="HRMS"
